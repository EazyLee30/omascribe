{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmaScribe",
  "version": "0.3.5",
  "identifier": "io.omarchy.omascribe",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OmaScribe",
        "width": 1160,
        "height": 780,
        "minWidth": 740,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 28
        },
        "resizable": true,
        "maximizable": true,
        "minimizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; font-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "omascribe"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3MDcwRjJBQjQ2RjVCM0QKUldROVcyKzBLZzhIaDF4RHZVRnRrb29BOThhZ0J3dGRoNU8vam9GZ0pPWHlBb1VQRTBZY1NlODAK",
      "endpoints": [
        "https://github.com/EazyLee30/omascribe/releases/latest/download/latest-runtime.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
