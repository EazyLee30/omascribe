{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmaScribe",
  "version": "0.1.0",
  "identifier": "io.omarchy.omascribe",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OmaScribe",
        "width": 1160,
        "height": 780,
        "minWidth": 740,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": { "active": false }
}
