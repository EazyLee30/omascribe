#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
export PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
for command in cargo npm pkg-config; do
  command -v "$command" >/dev/null || { echo "Missing $command. See README.md → Build." >&2; exit 1; }
done
pkg-config --exists gtk+-3.0 webkit2gtk-4.1 || { echo 'Missing GTK3 / WebKitGTK 4.1 development packages.' >&2; exit 1; }
npm ci --ignore-scripts
npm run build
exec cargo build --workspace --release --locked -j "${OMASCRIBE_BUILD_JOBS:-1}"
