{
  "name": "omascribe-landing",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync:release": "node scripts/sync-release.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run build && wrangler dev --port 8787",
    "check": "npm run build && npm test && node --check public/site.js && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.14.0",
    "@fontsource/barlow-condensed": "5.2.7"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
